{
  "PORT": 5000,
  "destinations": [
    {
      "name": "mcp-server-backend",
      "url": "http://localhost:8080",
      "forwardAuthToken": true
    }
  ],
  "VCAP_SERVICES": {
    "xsuaa": [
      {
        "name": "btp-cf-mcp-xsuaa",
        "label": "xsuaa",
        "tags": ["xsuaa"],
        "credentials": {
          "clientid": "sb-btp-cf-mcp!t1234",
          "clientsecret": "replace-with-xsuaa-client-secret",
          "url": "https://<subdomain>.authentication.<region>.hana.ondemand.com",
          "uaadomain": "authentication.<region>.hana.ondemand.com",
          "xsappname": "btp-cf-mcp!t1234",
          "verificationkey": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
        }
      }
    ]
  }
}
