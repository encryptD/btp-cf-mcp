{
  "authenticationMethod": "route",
  "sessionTimeout": 60,
  "routes": [
    {
      "source": "^/health$",
      "target": "/health",
      "destination": "mcp-server-backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/mcp(.*)$",
      "target": "/mcp$1",
      "destination": "mcp-server-backend",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.mcp.read"
      ],
      "csrfProtection": false
    },
    {
      "source": "^/sse(.*)$",
      "target": "/sse$1",
      "destination": "mcp-server-backend",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.mcp.read"
      ],
      "csrfProtection": false
    },
    {
      "source": "^/messages(.*)$",
      "target": "/messages$1",
      "destination": "mcp-server-backend",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.mcp.read"
      ],
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "mcp-server-backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    }
  ]
}
