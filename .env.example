# ============================================================================
# Local Development Environment Configuration
# Copy this file to .env for local runs without Cloud Foundry VCAP_SERVICES
# ============================================================================

# Application settings
APP_NAME=btp-cf-mcp-server
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO

# Authentication mode:
# - "xsuaa": Enforce strict XSUAA JWT validation (automatically forced when VCAP_SERVICES has xsuaa binding)
# - "mock": Allow unauthenticated or mock-token local requests with a synthetic UserSecurityContext
AUTH_MODE=mock

# Mock user profile used when AUTH_MODE=mock and no Authorization header is provided
MOCK_USER_ID=developer@example.com
MOCK_USER_GIVEN_NAME=Local
MOCK_USER_FAMILY_NAME=Developer
MOCK_TENANT_ID=default-dev-tenant
MOCK_SCOPES=btp-cf-mcp!t1234.mcp.read,btp-cf-mcp!t1234.mcp.execute,btp-cf-mcp!t1234.mcp.admin

# Optional: Override XSUAA validator backend ("auto", "xssec", "pyjwt")
# "auto" uses sap-xssec if installed, falling back to PyJWT + XSUAA JWKS endpoint
XSUAA_VALIDATOR_BACKEND=auto

# Optional: Local Destination Service mock URL (when testing OData calls locally without BTP Destination binding)
MOCK_DESTINATION_BASE_URL=https://services.odata.org/V4/Northwind/Northwind.svc
